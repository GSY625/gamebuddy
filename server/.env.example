# Database
DATABASE_URL=postgresql://gamebuddy:gamebuddy@localhost:5432/gamebuddy?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-in-production-use-long-random-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Admin
ADMIN_EMAILS=19834864753@163.com

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Upload
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Mail
# Development:
# Leave SMTP_* empty to use devCode + console output.
#
# Production:
# SMTP is required. Prefer authenticated submission on port 587.
# SMTP_PASS usually means the provider's SMTP password or app authorization code,
# not your normal mailbox login password.
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=replace-with-smtp-password-or-app-code
SMTP_FROM=开黑鸭 <no-reply@your-domain.com>
